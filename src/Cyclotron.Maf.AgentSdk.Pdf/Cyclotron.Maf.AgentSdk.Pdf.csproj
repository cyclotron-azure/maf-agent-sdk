<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- NuGet Package Metadata -->
    <PackageId>AgentSdk.Pdf</PackageId>
    <Description>PDF processing extensions for Cyclotron.Maf.AgentSdk. Provides PDF image extraction, content analysis, and markdown conversion using PdfPig. Supports vision model integration and document workflow orchestration.</Description>
    <PackageTags>ai;agents;pdf;pdf-processing;document-processing;pdfpig;vision-ai;image-extraction;markdown-conversion</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- Expose internals to test project -->
  <ItemGroup>
    <InternalsVisibleTo Include="Cyclotron.Maf.AgentSdk.Pdf.UnitTests" />
  </ItemGroup>

  <!-- Microsoft.Extensions Packages (minimal set for DI and configuration) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>

  <!-- PDF Processing Packages -->
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="PdfPig" />
  </ItemGroup>

  <!-- Package Content -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
