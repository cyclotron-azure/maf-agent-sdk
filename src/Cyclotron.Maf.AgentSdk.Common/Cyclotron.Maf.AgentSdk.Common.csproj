<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- NuGet Package Metadata -->
    <PackageId>AgentSdk.Common</PackageId>
    <Description>Shared common types and options for Cyclotron.Maf.AgentSdk and related packages. Contains model provider configuration definitions used across the SDK ecosystem.</Description>
    <PackageTags>ai;agents;configuration;common;model-provider</PackageTags>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!-- Azure SDK Packages -->
  <ItemGroup>
    <PackageReference Include="Azure.AI.Projects" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="OllamaSharp" />
  </ItemGroup>

  <!-- Microsoft.Extensions Packages for data annotations -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
  </ItemGroup>

  <!-- Package Content -->
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
